<resources>
    <style name="Theme.Whispey" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/whispey_background</item>
        <item name="android:navigationBarColor">@color/whispey_background</item>
        <item name="android:statusBarColor">@color/whispey_background</item>
        <!-- DARK mode: light icons on dark bar -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
